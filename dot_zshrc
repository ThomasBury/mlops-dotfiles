# =============================================================================
# ~/.zshrc
#
# Development shell for:
#   Python / ML / AI / MLOps
#   Docker / Kubernetes / Helm
#   Terraform / OpenTofu
#   Azure / AWS
#   Git / GitHub
#
# Principles:
#   - Keep standard Zsh/Emacs key bindings intact
#   - Do not shadow fundamental Unix commands
#   - Prefer completion over huge alias lists
#   - Keep project-specific environments out of ~/.zshrc
#   - Degrade gracefully when optional tools are not installed
# =============================================================================


# -----------------------------------------------------------------------------
# XDG directories
# -----------------------------------------------------------------------------

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"


# -----------------------------------------------------------------------------
# PATH
#
# Zsh exposes PATH as both:
#
#   $PATH  -> colon-separated string
#   $path  -> array
#
# `typeset -U` automatically removes duplicates.
# -----------------------------------------------------------------------------

# Some installers create this file to initialize their own PATH.
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

typeset -U path PATH

path=(
    "$HOME/.local/bin"
    "$HOME/.opencode/bin"
    $path
)

[[ -d "$HOME/bin" ]] && path=("$HOME/bin" $path)

export PATH


# -----------------------------------------------------------------------------
# mise
#
# Runtime/tool version management.
#
# Examples:
#
#   mise use python@3.13
#   mise use uv@latest
#   mise use terraform@latest
#
# Project versions belong in mise.toml, not here.
# -----------------------------------------------------------------------------

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi


# -----------------------------------------------------------------------------
# Keyboard editing
#
# Explicitly use conventional Emacs/readline-style shell bindings BEFORE
# loading interactive plugins.
#
# Plugins may enhance the action they are specifically responsible for
# (fzf-tab owns Tab), but we do not remap the standard editing shortcuts.
#
# Preserved:
#
#   Ctrl-A  beginning of line
#   Ctrl-E  end of line
#   Ctrl-W  delete previous word
#   Ctrl-U  kill line backwards
#   Ctrl-K  kill to end of line
#   Ctrl-R  reverse history search
#   Ctrl-P  previous history
#   Ctrl-N  next history
# -----------------------------------------------------------------------------

bindkey -e


# -----------------------------------------------------------------------------
# Oh My Zsh
# -----------------------------------------------------------------------------

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"

# Keep Oh My Zsh cache under XDG cache.
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$XDG_CACHE_HOME/oh-my-zsh}"

# Starship owns the prompt.
ZSH_THEME=""

# Do not unexpectedly update Oh My Zsh during shell startup.
zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 14

# Starship handles cloud information in the prompt.
export SHOW_AWS_PROMPT=false


# -----------------------------------------------------------------------------
# Completion
# -----------------------------------------------------------------------------

# Case-insensitive completion.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Cache expensive completion results.
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

# Make completion descriptions readable.
zstyle ':completion:*:descriptions' format '[%d]'

# If fzf-tab is installed, it owns the completion selection UI.
# Otherwise retain normal Zsh menu completion.
if [[ -d "$ZSH_CUSTOM/plugins/fzf-tab" ]] && command -v fzf >/dev/null 2>&1; then
    zstyle ':completion:*' menu no
else
    zstyle ':completion:*' menu select
fi


# -----------------------------------------------------------------------------
# Oh My Zsh plugins
#
# Keep the list targeted.
#
# We mainly want:
#
#   - high-quality completion
#   - useful Git helpers
#   - MLOps/cloud CLI integration
#
# rather than hundreds of aliases.
# -----------------------------------------------------------------------------

plugins=(
    git
    colored-man-pages
)


# Development / MLOps plugins.
#
# Only activate plugins actually shipped by the installed Oh My Zsh version.
for plugin in \
    uv \
    docker \
    kubectl \
    helm \
    terraform \
    aws \
    azure \
    gh
do
    plugin_command="$plugin"
    [[ "$plugin" == azure ]] && plugin_command=az
    if [[ -d "$ZSH/plugins/$plugin" ]] && command -v "$plugin_command" >/dev/null 2>&1; then
        plugins+=("$plugin")
    fi
done
unset plugin plugin_command


# -----------------------------------------------------------------------------
# Interactive plugins
#
# ORDER MATTERS:
#
#   fzf-tab
#       ↓
#   zsh-autosuggestions
#       ↓
#   zsh-syntax-highlighting
#
# fzf-tab must be loaded before plugins that wrap ZLE widgets.
# Syntax highlighting should remain last.
# -----------------------------------------------------------------------------


# Fuzzy Tab completion.
if [[ -d "$ZSH_CUSTOM/plugins/fzf-tab" ]] && command -v fzf >/dev/null 2>&1; then
    plugins+=(fzf-tab)
fi


# Inline suggestions from shell history.
#
# No custom key bindings are configured.
# Standard Right Arrow / End behaviour remains available for acceptance.
if [[ -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
    plugins+=(zsh-autosuggestions)
fi


# Must remain last among interactive ZLE plugins.
if [[ -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]]; then
    plugins+=(zsh-syntax-highlighting)
fi


# -----------------------------------------------------------------------------
# History
# -----------------------------------------------------------------------------

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

# Store timestamps and command durations.
setopt EXTENDED_HISTORY

# Share history between running terminals.
setopt SHARE_HISTORY

# Better duplicate handling.
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_EXPIRE_DUPS_FIRST

# Commands beginning with a space are not persisted.
#
# Useful as a small safety net for temporary sensitive commands.
# This is NOT a substitute for proper secret management.
setopt HIST_IGNORE_SPACE

setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

# Allow:
#
#   kubectl get pods   # inspect staging
#
setopt INTERACTIVE_COMMENTS


# -----------------------------------------------------------------------------
# Load Oh My Zsh
# -----------------------------------------------------------------------------

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi


# -----------------------------------------------------------------------------
# fzf-tab
#
# fzf-tab does not create another completion system.
#
# It presents the completion candidates already provided by:
#
#   Zsh
#   Oh My Zsh
#   kubectl
#   Helm
#   Terraform
#   Azure CLI
#   AWS CLI
#   uv
#   GitHub CLI
#   etc.
#
# Tab remains Tab completion; only its UI becomes fuzzy-searchable.
# -----------------------------------------------------------------------------

if [[ -d "$ZSH_CUSTOM/plugins/fzf-tab" ]] && command -v fzf >/dev/null 2>&1; then

    # Show groups such as:
    #
    #   [commands]
    #   [options]
    #   [directories]
    #
    zstyle ':completion:*:descriptions' format '[%d]'

    # Preview directory contents when completing `cd`.
    if command -v eza >/dev/null 2>&1; then
        zstyle ':fzf-tab:complete:cd:*' \
            fzf-preview 'eza -1 --color=always --icons $realpath'
    else
        zstyle ':fzf-tab:complete:cd:*' \
            fzf-preview 'ls -A -- $realpath'
    fi
fi


# -----------------------------------------------------------------------------
# Editor
# -----------------------------------------------------------------------------

if command -v nvim >/dev/null 2>&1; then
    export EDITOR="nvim"
    export VISUAL="nvim"
    export GIT_EDITOR="nvim"
elif command -v vim >/dev/null 2>&1; then
    export EDITOR="vim"
    export VISUAL="vim"
    export GIT_EDITOR="vim"
fi


# -----------------------------------------------------------------------------
# Atuin
#
# Atuin records all shell history in its structured database and owns:
#
#   Ctrl-R  atuin TUI search
#   Up      atuin context-aware up-search (single-line buffers only)
#
# Atuin initializes after Oh My Zsh, so its bindings take precedence
# over the standard history widgets.
#
# `hs` remains available for explicitly launching the search TUI.
# -----------------------------------------------------------------------------

if command -v atuin >/dev/null 2>&1; then
    unset ATUIN_NOBIND
    eval "$(atuin init zsh --disable-ai)"

    alias hs='atuin search -i'
fi


# -----------------------------------------------------------------------------
# zoxide
#
# Smarter directory navigation.
#
# Examples:
#
#   z project-name
#   z infra
#   z work
#   zi
# -----------------------------------------------------------------------------

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi


# -----------------------------------------------------------------------------
# direnv
#
# Project-scoped environment configuration.
#
# Good place for:
#
#   AWS_PROFILE
#   AZURE_CONFIG_DIR
#   MLFLOW_TRACKING_URI
#   DATABRICKS_CONFIG_PROFILE
#   project-specific endpoints
#
# Do NOT put project-specific environment state globally in ~/.zshrc.
# -----------------------------------------------------------------------------

if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi


# -----------------------------------------------------------------------------
# fzf
#
# Intentionally DO NOT run:
#
#     source <(fzf --zsh)
#
# because the standard fzf shell integration installs keybindings including
# Ctrl-R, Ctrl-T and Alt-C.
#
# fzf is used explicitly by:
#
#   fzf-tab
#   fcd
#   fv
#
# without taking over unrelated keyboard shortcuts.
# -----------------------------------------------------------------------------

if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

export FZF_DEFAULT_OPTS='
    --height=70%
    --layout=reverse
    --border
'


# -----------------------------------------------------------------------------
# Starship
#
# Initialize prompt after environment/tool initialization.
# -----------------------------------------------------------------------------

if command -v starship >/dev/null 2>&1; then
    if [[ -f "$XDG_CONFIG_HOME/starship/starship.toml" ]]; then
        export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"
    fi

    eval "$(starship init zsh)"
fi


# =============================================================================
# Aliases
# =============================================================================


# -----------------------------------------------------------------------------
# Editor / shell
# -----------------------------------------------------------------------------

if command -v nvim >/dev/null 2>&1; then
    alias v='nvim'
fi

alias zshrc='chezmoi edit --apply ~/.zshrc'
alias reload='exec zsh'


# -----------------------------------------------------------------------------
# Modern file listing
#
# Do NOT replace `ls`.
#
# Standard Unix commands retain their standard behaviour.
# -----------------------------------------------------------------------------

if command -v eza >/dev/null 2>&1; then

    alias ll='eza -lah --group-directories-first --icons --git'
    alias la='eza -a --group-directories-first --icons'
    alias lt='eza --tree --level=2 --group-directories-first --icons --git'

else

    alias ll='ls -lah'
    alias la='ls -A'

fi


# -----------------------------------------------------------------------------
# bat
#
# Do NOT replace `cat`.
#
# Use:
#
#   b file.py
#
# when syntax highlighting / paging is useful.
# -----------------------------------------------------------------------------

if command -v bat >/dev/null 2>&1; then
    alias b='bat'
fi


# -----------------------------------------------------------------------------
# Docker Compose
#
# Oh My Zsh's Docker plugin already provides common Docker aliases.
# These cover the modern `docker compose` workflow.
# -----------------------------------------------------------------------------

if command -v docker >/dev/null 2>&1; then

    alias dc='docker compose'

    alias dcu='docker compose up'
    alias dcud='docker compose up -d'
    alias dcd='docker compose down'

    alias dcl='docker compose logs'
    alias dclf='docker compose logs -f'

fi


# -----------------------------------------------------------------------------
# Cloud / Kubernetes situational awareness
#
# These helpers do not mutate anything.
#
# Their purpose is to answer:
#
#   "Where am I operating?"
#   "As whom am I operating?"
#
# before running infrastructure commands.
# -----------------------------------------------------------------------------

if command -v kubectl >/dev/null 2>&1; then

    alias kctx='kubectl config current-context'

    kwhere() {
        local context namespace

        context="$(kubectl config current-context 2>/dev/null)"

        namespace="$(
            kubectl config view \
                --minify \
                --output 'jsonpath={..namespace}' \
                2>/dev/null
        )"

        [[ -z "$namespace" ]] && namespace="default"

        printf 'context:   %s\n' "${context:-<none>}"
        printf 'namespace: %s\n' "$namespace"
    }

fi


if command -v aws >/dev/null 2>&1; then
    alias awswho='aws sts get-caller-identity'
fi


if command -v az >/dev/null 2>&1; then

    alias azwho='az account show \
        --query "{subscription:name, subscriptionId:id, tenant:tenantId, user:user.name}" \
        --output table'

fi


# =============================================================================
# Functions
# =============================================================================


# -----------------------------------------------------------------------------
# fcd
#
# Fuzzy-find a directory and cd into it.
#
# Usage:
#
#   fcd
#   fcd ~/projects
# -----------------------------------------------------------------------------

fcd() {

    command -v fzf >/dev/null 2>&1 || {
        print -u2 "fzf is not installed"
        return 1
    }

    local root="${1:-.}"
    local dir

    if command -v fd >/dev/null 2>&1; then

        dir="$(
            fd \
                --type d \
                --hidden \
                --follow \
                --exclude .git \
                . "$root" 2>/dev/null |
            fzf
        )"

    else

        dir="$(
            find "$root" \
                -type d \
                -not -path '*/.git/*' \
                2>/dev/null |
            fzf
        )"

    fi

    [[ -n "$dir" ]] && cd -- "$dir"
}


# -----------------------------------------------------------------------------
# fv
#
# Fuzzy-find a file and open it in $EDITOR.
#
# Usage:
#
#   fv
#   fv ~/projects
# -----------------------------------------------------------------------------

fv() {

    command -v fzf >/dev/null 2>&1 || {
        print -u2 "fzf is not installed"
        return 1
    }

    local root="${1:-.}"
    local file

    if command -v fd >/dev/null 2>&1; then

        file="$(
            fd \
                --type f \
                --hidden \
                --follow \
                --exclude .git \
                . "$root" 2>/dev/null |
            fzf
        )"

    else

        file="$(
            find "$root" \
                -type f \
                -not -path '*/.git/*' \
                2>/dev/null |
            fzf
        )"

    fi

    [[ -n "$file" ]] && "$EDITOR" "$file"
}


# -----------------------------------------------------------------------------
# va
#
# Explicitly activate a Python virtual environment.
#
# Default:
#
#   va
#
# Custom:
#
#   va path/to/venv
#
# With uv, prefer `uv run ...` for reproducible execution.
# This helper exists for interactive sessions where activation is useful.
# -----------------------------------------------------------------------------

va() {

    local venv="${1:-.venv}"

    if [[ ! -f "$venv/bin/activate" ]]; then
        print -u2 "No virtual environment found at: $venv"
        return 1
    fi

    source "$venv/bin/activate"
}


# -----------------------------------------------------------------------------
# serve
#
# Tiny local HTTP server.
#
#   serve
#   serve 9000
# -----------------------------------------------------------------------------

serve() {
    python3 -m http.server "${1:-8000}"
}


# -----------------------------------------------------------------------------
# Machine-local overrides
#
# ~/.zshrc.local is NOT versioned.
#
# Use it for machine-specific settings that do not belong in the dotfiles
# repository (work hostnames, local experiments, temporary workarounds).
# -----------------------------------------------------------------------------

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

