{
    "workbench.colorTheme": "Andromeda",
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "editor.formatOnSave": true,
    "jupyter.askForKernelRestart": false,
    "terminal.integrated.inheritEnv": true,
    "redhat.telemetry.enabled": true,
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 50,
    "diffEditor.codeLens": true,
    "marimo.marimoPath": "uv run marimo",
    "chat.mcp.discovery.enabled": {
        "claude-desktop": false,
        "windsurf": false,
        "cursor-global": false,
        "cursor-workspace": false,
        "copilot": false
    },
    "jupyter.interactiveWindow.creationMode": "perFile",
    "docker.extension.enableComposeLanguageServer": false,
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal",
        "kilo-code.new.agentManager.previousTerminal",
        "kilo-code.new.agentManager.nextTerminal"
    ],
    "kilo-code.new.agentWorkStyle": "skipped",
    "python.analysis.typeCheckingMode": "standard"
}
