# =============================================================================
# Git configuration, rendered by chezmoi.
#
# Identity comes from the data collected by `chezmoi init`
# (see .chezmoi.toml.tmpl) and is stored locally in
# ~/.config/chezmoi/chezmoi.toml — never in this repository.
# =============================================================================

[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}

[init]
	defaultBranch = main

[credential]
	helper = ! gh auth git-credential

# Machine-local overrides (unversioned, same pattern as ~/.zshrc.local).
# Sourced only if you create the file.
[include]
	path = "~/.gitconfig.local"
