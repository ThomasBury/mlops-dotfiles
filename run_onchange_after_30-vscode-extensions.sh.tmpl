#!/usr/bin/env bash

# =============================================================================
# run_onchange_after: install VS Code extensions
#
# Re-runs automatically whenever this file's content changes, because chezmoi
# hashes the rendered script. Editing the EXTENSIONS list below is therefore
# enough to roll the change out with `chezmoi apply`.
# code CLI at apply time: {{ lookPath "code" }}
#
# Idempotent: extensions already installed are left alone by the CLI.
# =============================================================================

set -Eeuo pipefail

if ! command -v code >/dev/null 2>&1; then
    echo "code CLI not found; skipping VS Code extension install" >&2
    exit 0
fi

log() {
    printf '\n\033[1;34m==>\033[0m %s\n' "$*"
}

# Desired extension set. `ms-azuretools.vscode-docker` is intentionally absent:
# it is superseded by ms-azuretools.vscode-containers and removed below.
EXTENSIONS=(
    adpyke.codesnap
    ahmadawais.shades-of-purple
    antfu.slidev
    batisteo.vscode-django
    bierner.markdown-mermaid
    bierner.markdown-preview-github-styles
    charliermarsh.ruff
    coderabbit.coderabbit-vscode
    davidanson.vscode-markdownlint
    eliverlara.andromeda
    github.vscode-github-actions
    golang.go
    janisdd.vscode-edit-csv
    kamikillerto.vscode-colorize
    kilocode.kilo-code
    loilo.snazzy-light
    marimo-team.vscode-marimo
    marp-team.marp-vscode
    mhutchie.git-graph
    ms-azuretools.vscode-containers
    ms-kubernetes-tools.vscode-kubernetes-tools
    ms-python.debugpy
    ms-python.python
    ms-python.vscode-pylance
    ms-python.vscode-python-envs
    ms-toolsai.jupyter
    ms-toolsai.jupyter-keymap
    ms-toolsai.jupyter-renderers
    ms-toolsai.vscode-jupyter-cell-tags
    ms-toolsai.vscode-jupyter-slideshow
    ms-vscode-remote.remote-containers
    ms-vscode-remote.remote-ssh
    ms-vscode-remote.remote-ssh-edit
    ms-vscode.makefile-tools
    ms-vscode.remote-explorer
    nefrob.vscode-just-syntax
    njpwerner.autodocstring
    openai.chatgpt
    quarto.quarto
    redhat.vscode-yaml
    repreng.csv
    sirilganjai.code-visualizer
    systemticks.c4-dsl-extension
    tamasfe.even-better-toml
    tomoki1207.pdf
    uloco.theme-bluloco-light
    vivaxy.vscode-conventional-commits
    wholroyd.jinja
    yzhang.markdown-all-in-one
)

log "Installing ${#EXTENSIONS[@]} VS Code extensions"

failed=0
for extension in "${EXTENSIONS[@]}"; do
    if code --install-extension "$extension"; then
        echo "  installed $extension"
    else
        echo "  FAILED to install $extension" >&2
        failed=1
    fi
done

if ((failed)); then
    echo "Extension installation failed; run chezmoi apply again to retry." >&2
    exit 1
fi

# Retire the extension superseded by ms-azuretools.vscode-containers.
installed="$(code --list-extensions)"
if grep -qx 'ms-azuretools.vscode-docker' <<< "$installed" && \
   grep -qx 'ms-azuretools.vscode-containers' <<< "$installed"; then
    log "Removing superseded ms-azuretools.vscode-docker"
    code --uninstall-extension ms-azuretools.vscode-docker
fi
