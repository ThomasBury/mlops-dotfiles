#!/usr/bin/env bash

# =============================================================================
# run_onchange_after: install VS Code extensions
#
# Re-runs automatically whenever this file's content changes, because chezmoi
# hashes the rendered script. Editing the EXTENSIONS list below is therefore
# enough to roll the change out with `chezmoi apply`.
#
# Idempotent: extensions already installed are left alone by the CLI.
# =============================================================================

set -Eeuo pipefail

if ! command -v code >/dev/null 2>&1; then
    echo "code CLI not found; skipping VS Code extension install" >&2
    exit 0
fi

log() {
    printf '\n\033[1;34m==>\033[0m %s\n' "$*"
}

# Desired extension set. `ms-azuretools.vscode-docker` is intentionally absent:
# it is superseded by ms-azuretools.vscode-containers and removed below.
EXTENSIONS=(
    adpyke.codesnap
    ahmadawais.shades-of-purple
    antfu.slidev
    batisteo.vscode-django
    bierner.markdown-mermaid
    bierner.markdown-preview-github-styles
    charliermarsh.ruff
    coderabbit.coderabbit-vscode
    davidanson.vscode-markdownlint
    docker.docker
    donjayamanne.githistory
    donjayamanne.python-extension-pack
    eamodio.gitlens
    ekstasis.vscode-color-picker-hex
    eliverlara.andromeda
    github.vscode-github-actions
    golang.go
    janisdd.vscode-edit-csv
    kamikillerto.vscode-colorize
    kevinrose.vsc-python-indent
    kilocode.kilo-code
    loilo.snazzy-light
    marimo-team.vscode-marimo
    marp-team.marp-vscode
    mechatroner.rainbow-csv
    mhutchie.git-graph
    ms-azuretools.vscode-containers
    ms-kubernetes-tools.vscode-kubernetes-tools
    ms-python.debugpy
    ms-python.python
    ms-python.vscode-pylance
    ms-python.vscode-python-envs
    ms-toolsai.jupyter
    ms-toolsai.jupyter-keymap
    ms-toolsai.jupyter-renderers
    ms-toolsai.vscode-jupyter-cell-tags
    ms-toolsai.vscode-jupyter-slideshow
    ms-vscode-remote.remote-containers
    ms-vscode-remote.remote-ssh
    ms-vscode-remote.remote-ssh-edit
    ms-vscode.makefile-tools
    ms-vscode.remote-explorer
    nefrob.vscode-just-syntax
    njpwerner.autodocstring
    openai.chatgpt
    quarto.quarto
    redhat.vscode-yaml
    repreng.csv
    sirilganjai.code-visualizer
    sst-dev.opencode
    systemticks.c4-dsl-extension
    tamasfe.even-better-toml
    tomoki1207.pdf
    uloco.theme-bluloco-light
    vivaxy.vscode-conventional-commits
    wholroyd.jinja
    yzhang.markdown-all-in-one
    zainchen.json
)

log "Installing ${#EXTENSIONS[@]} VS Code extensions"

for extension in "${EXTENSIONS[@]}"; do
    if code --install-extension "$extension" >/dev/null 2>&1; then
        echo "  installed $extension"
    else
        echo "  FAILED to install $extension" >&2
    fi
done

# Retire the extension superseded by ms-azuretools.vscode-containers.
if code --list-extensions | grep -qx 'ms-azuretools.vscode-docker'; then
    log "Removing superseded ms-azuretools.vscode-docker"
    code --uninstall-extension ms-azuretools.vscode-docker >/dev/null 2>&1 || true
fi
