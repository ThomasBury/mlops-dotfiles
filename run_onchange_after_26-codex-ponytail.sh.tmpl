#!/usr/bin/env bash
set -Eeuo pipefail

# Codex CLI at apply time: {{ lookPath "codex" }}
# Config modifier sha256: {{ include "dot_codex/modify_private_config.toml" | sha256sum }}

if [[ -n "${CI:-}" ]]; then
    echo "CI detected; skipping Codex Ponytail installation"
    exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
    echo "codex CLI not found; skipping Ponytail installation" >&2
    exit 0
fi

# Use the workstation's Node and jq, independent of the calling project.
cd "$HOME"
export PATH="$HOME/.local/share/mise/shims:${PATH:-/usr/bin:/bin}"

marketplaces="$(codex plugin marketplace list --json)"
registered="$(jq -r '.marketplaces | any(.name == "ponytail")' <<< "$marketplaces")"
if [[ "$registered" != true ]]; then
    codex plugin marketplace add DietrichGebert/ponytail
fi

plugins="$(codex plugin list --json --marketplace ponytail)"
enabled="$(jq -r '.installed | any(.pluginId == "ponytail@ponytail" and .installed and .enabled)' <<< "$plugins")"
if [[ "$enabled" != true ]]; then
    codex plugin add ponytail@ponytail
    plugins="$(codex plugin list --json --marketplace ponytail)"
fi
jq -e '.installed | any(.pluginId == "ponytail@ponytail" and .installed and .enabled)' <<< "$plugins" >/dev/null

# Re-render after installation; scripts are excluded to prevent recursion.
{{ .chezmoi.executable | shellQuote }} --config {{ .chezmoi.configFile | shellQuote }} \
    --source {{ .chezmoi.sourceDir | shellQuote }} --destination {{ .chezmoi.destDir | shellQuote }} \
    --refresh-externals=never apply --exclude scripts "$HOME/.codex/config.toml"
